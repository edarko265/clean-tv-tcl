[Unit]
Description=Clean TV private phone remote
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clean-tv-remote
Group=clean-tv-remote
WorkingDirectory=/opt/clean-tv-remote
EnvironmentFile=/etc/clean-tv-remote
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/clean-tv-remote/venv/bin/python -I /opt/clean-tv-remote/phone_remote.py --tv ${TV_HOST} --data-dir /var/lib/clean-tv-remote --service-links=${SERVICE_LINKS} --wyoming-whisper=${WYOMING_WHISPER} --public-base-url=${PUBLIC_BASE_URL}
Restart=on-failure
RestartSec=4
NoNewPrivileges=true
UMask=0077
RemoveIPC=true
PrivateDevices=true
DevicePolicy=closed
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/clean-tv-remote
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=10.0.0.0/8
IPAddressAllow=172.16.0.0/12
IPAddressAllow=192.168.0.0/16
IPAddressAllow=::1/128
IPAddressAllow=fc00::/7
IPAddressAllow=fe80::/10

[Install]
WantedBy=multi-user.target
